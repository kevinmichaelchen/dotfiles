{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "mcp": {
    "servers": {
      "executor": {
        "type": "remote",
        "url": "https://executor.sh/kevin-chen-s-organization/mcp",
        "disabled": false
      },
      "executor-desktop": {
        "type": "local",
        "command": [
          "executor",
          "mcp"
        ],
        "disabled": false
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "reasoningEffort": "medium",
        "reasoningSummary": "auto",
        "textVerbosity": "medium",
        "include": [
          "reasoning.encrypted_content"
        ],
        "store": false
      }
    },
    "openrouter": {
      "models": {
        "xiaomi/mimo-v2.6-pro": { "disabled": false },
        "xiaomi/mimo-v2.6-flash": { "disabled": false },
        "z-ai/glm-5.3": { "disabled": false },
        "z-ai/glm-5.3-flash": { "disabled": false },
        "deepseek/deepseek-v4.1-flash": { "disabled": false },
        "minimax/minimax-m3": { "disabled": false },
        "moonshotai/kimi-k3": { "disabled": false }
      },
      "body": {
        "provider": {
          "data_collection": "deny"
        }
      }
    },
    "fireworks-ai": {
      "models": {
        "accounts/fireworks/models/glm-5p3": { "disabled": false },
        "accounts/fireworks/models/glm-5p3-flash": { "disabled": false },
        "accounts/fireworks/models/deepseek-v4p1-flash": { "disabled": false },
        "accounts/fireworks/models/minimax-m3": { "disabled": false },
        "accounts/fireworks/models/kimi-k3": { "disabled": false }
      }
    }
  },
  "agents": {
    "title": {
      "model": "openai/gpt-6-luna"
    }
  }
}
